# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env ke GitHub.

# --- MySQL 8 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cryptovault_user
DB_PASSWORD=ganti_dengan_password_anda
DB_NAME=cryptovault

# --- Key Management (isi dengan 32 byte acak, base64) ---
# Contoh membuat: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEK=
ANCHOR_HMAC_KEY=

# --- Windows Hello: real | simulation (simulation HANYA untuk pengujian) ---
WINDOWS_HELLO_MODE=real

# --- USB Dongle ---
DONGLE_KEY_FILENAME=cryptovault.key

# --- Storage & Logging ---
STORAGE_ENCRYPTED_FILES=storage/encrypted_files
STORAGE_STEGO_IMAGES=storage/stego_images
STORAGE_TEMP=storage/temp
LOG_LEVEL=INFO
